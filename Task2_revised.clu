// Aufgabe 2 (revised): two-link arm, elbow from a circle-plane meet
// ---------------------------------------------------------------------------
// Changes w.r.t. the submitted version
//  * sliders are defined before they are used
//  * reachability is classified before the point pair is factorised
//    (P.P < 0 means |A| > 2: no real elbow exists)
//  * the helper plane U^H^A^einf degenerates when A lies on the vertical axis;
//    in that case the x-axis is used as the second direction
//  * points are normalised by division by (-X.einf) before heights are compared
// ---------------------------------------------------------------------------

_BGColor = White;
:DRAW_POINT_AS_SPHERE;
SetLineWidth(4);
DefVarsN3();
SetMode(N3_OPNS);

// target (the reach of two unit links is 2)
?a = Slider("x", -2, 2, 0.05, 0);
?b = Slider("y", -2, 2, 0.05, 0.5);
?c = Slider("z", -2, 2, 0.05, -1);

:U = VecN3(0,0,0) : Black;                                     // shoulder
:Kugel1 = SphereN3(U,1) : Color(0.05, 0.05, 0.6, 0.3);          // upper arm, length 1
:A = VecN3(a,b,c) : Black;                                     // target
:Kugel2 = SphereN3(A,1) : Color(1, 0, 0, 0.1);                 // forearm, length 1

// ground plate (display only)
:X = VecN3(2,0,0) : Color(0.05, 0.05, 0.6, 1);
:Y = VecN3(0,0,2) : Color(0.05, 0.05, 0.6, 1);
:Bodenplatte = 4*(U^X^Y^einf) : Color(0.96, 0.90, 0.70, 0.6);

// vertical helper plane through U and A
if (a*a + c*c > 0.000001)
{H = VecN3(0,1,0)}
else
{H = VecN3(1,0,0)}
:E = 8*(U^H^A^einf) : Color(0.0, 0.3, 0.2, 0.3);

// circle of all possible elbows, then its meet with the helper plane
:S_kreis = *(*Kugel1 ^ *Kugel2) : Black;
S_points = *(*S_kreis ^ *E);
?Klass = S_points . S_points;      // > 0: reachable, 0: fully stretched, < 0: unreachable

if (Klass < 0)
{
  ?Unreachable = 1;
}
else
{
  Pp1 = ( sqrt(Klass) + S_points) / (einf . S_points);
  Pp2 = (-sqrt(Klass) + S_points) / (einf . S_points);
  N_Pp1 = Pp1 / (-(Pp1 . einf));
  N_Pp2 = Pp2 / (-(Pp2 . einf));

  // policy: upper elbow (larger y)
  if (N_Pp1 . e2 > N_Pp2 . e2)
  {elbow = N_Pp1}
  else
  {elbow = N_Pp2}
  :elbow;
  ?elbow;

  DrawLine(U, elbow);        // upper arm
  DrawLine(elbow, A);        // forearm
}
