// three-link arm U-E1-E2-A with unit links
// ---------------------------------------------------------------------------

_BGColor = White;
:DRAW_POINT_AS_SPHERE;
SetLineWidth(4);
DefVarsN3();
SetMode(N3_OPNS);

// target (the reach of three unit links is 3)
?a = Slider("x", -3, 3, 0.05, 0.5);
?b = Slider("y", -3, 3, 0.05, 0.5);
?c = Slider("z", -3, 3, 0.05, -1);

:U = VecN3(0,0,0) : Black;                                    // shoulder
:A = VecN3(a,b,c) : Black;                                    // end point
:Kugel1 = SphereN3(U,1) : Color(0.4, 0.4, 0.2, 0.2);           // first link (display)
:Kugel2 = SphereN3(A,1) : Color(0.02, 0.02, 0.4, 0.2);         // last link

// ground plate (display only)
:X = VecN3(2,0,0) : Blue;
:Y = VecN3(0,0,2) : Blue;
:Bodenplatte = 4*(U^X^Y^einf) : Color(0.35, 0.0, 0.1, 0.3);

d2 = a*a + b*b + c*c;
if (d2 == 0)
{
  // The target direction and the isosceles-trapezoid family are undefined.
  ?DegenerateTarget = 1;
}
else
{
  // Vertical helper plane through U and A, with an x-axis fallback.
  radial2 = a*a + c*c;
  if (radial2 > 0.000000000001*d2)
  {
    H = VecN3(0,1,0);
    BranchAxis = 2;              // e2: prefer the upper branch
  }
  else
  {
    H = VecN3(1,0,0);
    BranchAxis = 1;              // e1: deterministic fallback on the vertical axis
  }
  :HE = 10*(U^H^A^einf) : Color(0.96, 0.90, 0.70, 0.3);

  // Auxiliary points W+- on the line UA at distance 1 from A.
  :Gerade = 4*(U^A^einf);
  GKA = *(*Gerade ^ *Kugel2);
  Pp1 = ( sqrt(GKA . GKA) + GKA) / (einf . GKA);
  Pp2 = (-sqrt(GKA . GKA) + GKA) / (einf . GKA);
  N_Pp1 = Pp1 / (-(Pp1 . einf));
  N_Pp2 = Pp2 / (-(Pp2 . einf));

  // Explicit choice: W+ is the point farther from U (-U.X = |x|^2 / 2).
  if (-(U . N_Pp1) > -(U . N_Pp2))
  {Wplus = N_Pp1}
  else
  {Wplus = N_Pp2}
  :Wplus;

  // E2: distance 1 from A and equidistant from U and W+.
  :GelenkEbene = *(U - Wplus) : Color(0.5, 0.6, 0.7, 0.3);
  :SKGE = *(*GelenkEbene ^ *Kugel2) : Black;
  SPP = *(*SKGE ^ *HE);
  ?Klass = SPP . SPP;          // < 0: target out of reach (|A| > 3)

  if (Klass < 0)
  {
    ?Unreachable = 1;
  }
  else
  {
    Pp21 = ( sqrt(Klass) + SPP) / (einf . SPP);
    Pp22 = (-sqrt(Klass) + SPP) / (einf . SPP);
    N_Pp21 = Pp21 / (-(Pp21 . einf));
    N_Pp22 = Pp22 / (-(Pp22 . einf));

    // Policy: upper configuration; on the vertical axis use the +x branch.
    if (BranchAxis == 2)
    {
      if (N_Pp21 . e2 > N_Pp22 . e2)
      {elbow2 = N_Pp21}
      else
      {elbow2 = N_Pp22}
    }
    else
    {
      if (N_Pp21 . e1 > N_Pp22 . e1)
      {elbow2 = N_Pp21}
      else
      {elbow2 = N_Pp22}
    }

    // E1: reflection of E2 in the bisector plane of U and A.
    M = U - A;
    elbow1 = -M * elbow2 / M;

    :elbow1;
    :elbow2;
    ?elbow1;
    ?elbow2;

    DrawLine(U, elbow1);
    DrawLine(elbow1, elbow2);
    DrawLine(elbow2, A);
  }
}
